{
  "name": "duel-compass",
  "version": "1.4.0-beta.1",
  "description": "Duel Compass: Yu-Gi-Oh card research, source-backed rulings, deck learning, replay analysis and local duel tools.",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "main": "mcp/server.mjs",
  "bin": {
    "duel-compass-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./mcp/server.mjs",
    "./lib": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "mcp",
    "lib",
    "patches",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "skill/backend",
    "skill/runtime",
    "skill/package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "yugioh",
    "ygopro",
    "game-ai",
    "mcp",
    "model-context-protocol",
    "ocgcore",
    "duel-engine"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "koishipro-core.js": "1.5.2",
    "sql.js": "1.14.1",
    "ygopro-msg-encode": "1.3.0",
    "ygopro-yrp-encode": "1.0.8",
    "jszip": "3.10.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whiteball-shiro/duel-compass.git"
  },
  "homepage": "https://github.com/whiteball-shiro/duel-compass",
  "bugs": {
    "url": "https://github.com/whiteball-shiro/duel-compass/issues"
  },
  "scripts": {
    "start": "node mcp/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "data:init": "node scripts/init-data.mjs",
    "data:rulings": "node scripts/sync-ruling-sources.mjs --allow-network-update"
  }
}
